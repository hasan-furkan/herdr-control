{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "block",
      "size": {
        "px": 232
      },
      "min": 180,
      "max": 360,
      "background": "chrome",
      "resizable": false,
      "content": {
        "mod": "herdr-control",
        "props": {
          "part": "nav"
        }
      }
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "content": {
            "mod": "herdr-control-tabs"
          }
        },
        {
          "id": "work-stack",
          "type": "stack",
          "active": "screen",
          "children": [
            {
              "id": "terminal",
              "type": "row",
              "padding": 8,
              "gap": 8,
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "gap": 8,
                      "radius": 10,
                      "background": "background",
                      "lone": true,
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "header": {
                        "content": {
                          "mod": "pane"
                        },
                        "height": 30,
                        "position": "top",
                        "reveal": "always"
                      }
                    }
                  }
                },
                {
                  "id": "aside",
                  "type": "block",
                  "hidden": true,
                  "size": {
                    "px": 300
                  },
                  "min": 260,
                  "max": 420,
                  "background": "canvas",
                  "content": {
                    "mod": "herdr-control",
                    "props": {
                      "part": "aside"
                    }
                  }
                },
                {
                  "id": "panel",
                  "type": "column",
                  "hidden": true,
                  "size": {
                    "px": 368
                  },
                  "min": 280,
                  "max": 900,
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "active": "files",
                      "children": [
                        {
                          "id": "files",
                          "type": "block",
                          "content": {
                            "mod": "files"
                          }
                        },
                        {
                          "id": "changes",
                          "type": "block",
                          "content": {
                            "mod": "changes"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "screen",
              "type": "block",
              "background": "canvas",
              "content": {
                "mod": "herdr-control",
                "props": {
                  "part": "content"
                }
              }
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "herdr-control",
            "props": {
              "part": "status"
            }
          }
        }
      ]
    }
  ]
}
